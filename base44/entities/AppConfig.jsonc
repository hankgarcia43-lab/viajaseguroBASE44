{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Clave de configuraci\u00f3n"
    },
    "config_value": {
      "type": "string",
      "description": "Valor de configuraci\u00f3n"
    },
    "config_type": {
      "type": "string",
      "enum": [
        "number",
        "string",
        "boolean",
        "json"
      ],
      "description": "Tipo de dato"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la configuraci\u00f3n"
    },
    "category": {
      "type": "string",
      "enum": [
        "pricing",
        "kyc",
        "payments",
        "matching",
        "general"
      ],
      "description": "Categor\u00eda"
    }
  },
  "required": [
    "config_key",
    "config_value"
  ]
}